{
  "format": 1,
  "name": "ai-mse",
  "title": "ai-mse 全栈采集",
  "description": "两形态：mono=租户单体（tenant-starter + 勾选业务积木聚合 fat-jar + 应用镜像 + UI zip）；micro=微服务套件（基座五件套 + 勾选业务 boot 逐服务镜像，配置走 Nacos 基线）。产物经 build-manifest.json 交 collect-kit 核心推送 deliver-studio。",
  "preset": "studio-preset.json",
  "repoRoot": "../../../ai-mse",
  "scan": {
    "modulesDir": "mse-modules",
    "modulePrefix": "mse-",
    "requireSuffix": "-service",
    "probeDirs": [
      { "suffix": "-ui", "label": "ui" },
      { "suffix": "-mobile-ui", "label": "mobile-ui" }
    ],
    "versionFile": "mse-framework/pom.xml",
    "versionDefault": "1.0.0-SNAPSHOT"
  },
  "middleware": [
    { "code": "mysql", "label": "MySQL 数据库" },
    { "code": "redis", "label": "Redis 缓存" },
    { "code": "rocketmq", "label": "消息队列（事务/事件）" },
    { "code": "elasticsearch", "label": "搜索引擎（Elasticsearch 9）" },
    { "code": "rustfs", "label": "对象存储（S3 兼容，文件服务底座）" },
    { "code": "milvus", "label": "向量数据库（AI 知识库检索）" },
    { "code": "openim", "label": "即时通讯" }
  ],
  "params": [
    { "name": "name", "kind": "text", "label": "套件名（租户标识，必填）", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    { "name": "version", "kind": "text", "label": "版本", "default": "1.0.0", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    {
      "name": "form", "kind": "choice", "label": "部署形态", "default": "mono",
      "choices": [
        { "value": "mono", "label": "租户单体（tenant-starter 私有部署）" },
        { "value": "micro", "label": "微服务套件（基座五件套 + 勾选业务服务，配置走 Nacos 基线）" }
      ]
    },
    { "name": "ui", "kind": "bool", "label": "构建前端（基座 + 移动基站 + 已选模块的 PC / 移动子应用）", "default": "true" },
    { "name": "modules", "kind": "modules", "label": "业务模块（勾选参与交付）" },
    { "name": "middleware", "kind": "middleware", "label": "中间件（备料镜像 + 打包组件）" },
    { "name": "out", "kind": "out", "label": "输出目录（相对路径 = 仓库根）", "default": "./tenant-kit" },
    { "name": "baseVersion", "kind": "text", "label": "基座版本（已自动读取，一般不改）", "defaultFromScan": "baseVersion" }
  ],
  "actions": {
    "collect": {
      "hook": { "sh": "hooks/collect.sh", "ps1": "hooks/collect.ps1" },
      "repushProfiles": ["mono"]
    },
    "pushImages": {
      "whenParam": [
        { "param": "form", "equals": "micro", "images": ["nacos/nacos-server:v3.0.0"] }
      ],
      "middleware": {
        "mysql": [{ "ref": "mysql:8.4" }],
        "redis": [{ "ref": "redis:7-alpine" }],
        "rocketmq": [{ "ref": "apache/rocketmq:5.3.1" }],
        "elasticsearch": [{ "build": "mse/elasticsearch:9.2.8-smartcn", "context": "mse-framework/docker/elasticsearch" }],
        "rustfs": [{ "ref": "rustfs/rustfs:1.0.0-alpha.83-glibc" }],
        "milvus": [
          { "ref": "quay.io/coreos/etcd:v3.5.14" },
          { "ref": "minio/minio:RELEASE.2024-05-28T17-19-04Z" },
          { "ref": "milvusdb/milvus:v2.6.0" }
        ],
        "openim": [
          { "ref": "mongo:7.0.28" },
          { "ref": "bitnamilegacy/kafka:3.5.1" },
          { "ref": "bitnamilegacy/etcd:3.5.13" },
          { "ref": "minio/minio:RELEASE.2024-05-28T17-19-04Z" },
          { "ref": "openim/openim-server:v3.8.3-patch.15" },
          { "ref": "livekit/livekit-server:latest" }
        ]
      }
    }
  }
}
